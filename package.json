{
  "name": "electronics-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:push": "npm run db:push -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:seed": "npm run db:seed -w backend",
    "staff:reset-password": "npm run staff:reset-password -w backend",
    "staff:reset-to-setup": "npm run staff:reset-to-setup -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
